@[export leanparsergenerator_frontend_generated_ligparser_parse]
def parse (input : List (Runtime.Positioned LigTok)) (logNSteps : Nat := 20) : Option Frontend.LigResult :=
  match run input logNSteps with
  | .ok (_, .v0 r) => some r
  | _ => none

/-- The readable name of a terminal index (EOF is "end of input"). -/
def terminalName : Nat → String
  | 0 => "HEADER"
  | 1 => "LEXERHEADER"
  | 2 => "LEXER"
  | 3 => "TYVAL"
  | 4 => "TYPELINE"
  | 5 => "ACTION"
  | 6 => "IDENT"
  | 7 => "KW_TOKENTYPE"
  | 8 => "KW_TOKEN"
  | 9 => "KW_EOF"
  | 10 => "KW_START"
  | 11 => "KW_OPTION"
  | 12 => "PCTPCT"
  | 13 => "DCOLON"
  | 14 => "PIPE"
  | 15 => "EQ"
  | 16 => "EOF"
  | 17 => "end of input"
  | n => s!"terminal {n}"

/-- Diagnose a parse: on rejection, the offending token index and expected set. -/
def diagnose (input : List (Runtime.Positioned LigTok)) (logNSteps : Nat := 20) :
    Runtime.Exec.Diagnostic VP :=
  Runtime.Exec.diagnose table 18 (input.map decode) logNSteps

/-- Diagnose, also recovering the offending token's source span for line:col. -/
def diagnoseSpanned (input : List (Runtime.Positioned LigTok)) (logNSteps : Nat := 20) :
    Runtime.Exec.Diagnostic VP × Option Runtime.Span :=
  Runtime.Exec.diagnoseSpanned table 18 (fun (sp, _) => some sp) (input.map decode) logNSteps

/-- A human-readable syntax-error message, or `none` when the input parses.
    Pass `source` to render `line:col`; `messages` overrides per-state text. -/
def errorMessage (input : List (Runtime.Positioned LigTok)) (source : String := "")
    (messages : Nat → Option String := fun _ => none) (logNSteps : Nat := 20) : Option String :=
  match diagnoseSpanned input logNSteps with
  | (.error e, span) => some (e.formatWithSource span source terminalName messages)
  | _ => none

