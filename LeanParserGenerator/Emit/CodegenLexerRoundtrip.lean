module
/-
The offline lexer roundtrip backend. `%option roundtrip_lexer` emits a separate
`FooLexerRoundtrip.lean` module. The user owns
`FooLexerRoundtripSupport.lean`, which imports `FooLexer` and defines the complete
`renderTok : Tok → String` used by the theorem.

The generated module proves one universal statement over lists of
`Lexer.RoundtrippableTok`. It does not enumerate examples, synthesize reachability
witnesses, or claim constructor coverage. Value-carrying actions remain ordinary
Lean proof obligations when a caller establishes `RoundtrippableTok` for a value.
-/
public import LeanParserGenerator.Frontend.File
public import LeanParserGenerator.Lexer.Roundtrip
public import LeanParserGenerator.Emit.Builder


@[expose] public section

namespace Emit

open Frontend Lexer

def boolLit (b : Bool) : String := if b then "true" else "false"

def eofConstructor? (tokTy : String) (spec : LexerSpec) : Option String :=
  spec.eof.bind fun e =>
    let e := e.trimAscii.toString
    if e.startsWith s!"{tokTy}." then some ((e.drop (tokTy.length + 1)).toString)
    else if e.startsWith "." then some ((e.drop 1).toString)
    else none

/-- Check the restrictions used by the current universal proof: one start mode,
    only `.stay` actions, a one-character space skip rule, and a named EOF token. -/
def validateRoundtripLexer (surface : Surface) : Except String (LexerSpec × LexerMode × String) := do
  let some spec := surface.lexer
    | .error "no `%lexer` block in the grammar; nothing to generate"
  if spec.modes.size != 1 then
    .error s!"`%option roundtrip_lexer` currently supports exactly one lexer mode; found {spec.modes.size}"
  let mode := spec.modes[0]!
  let moving := (List.zip (List.range mode.rules.size) mode.rules.toList).filterMap fun (i, r) =>
    if r.trans == .stay then none else some i
  if !moving.isEmpty then
    .error s!"`%option roundtrip_lexer` currently requires every action to stay in the start mode; non-stay rule indices: {String.intercalate ", " (moving.map toString)}"
  if mode.rules.isEmpty then
    .error "`%option roundtrip_lexer` requires at least one lexer rule"
  let regexes := mode.rules.map (·.regex)
  match Lexer.bestMatch regexes [' '] with
  | some (rule, len) =>
      if len != 1 then
        .error "`%option roundtrip_lexer` uses the separator ` `, but the winning rule does not consume exactly one character"
      let r := mode.rules[rule]!
      if r.emit.isSome then
        .error "`%option roundtrip_lexer` uses the separator ` `, but its winning rule emits a token instead of skipping"
      if r.trans != .stay then
        .error "`%option roundtrip_lexer` uses the separator ` `, but its winning rule changes lexer mode"
  | none =>
      .error "`%option roundtrip_lexer` requires a skip rule that accepts the separator ` `"
  let some eof := eofConstructor? surface.tokenType spec
    | .error "`%option roundtrip_lexer` requires `eof` to be a token constructor such as `Tok.EOF`"
  return (spec, mode, eof)

/-- Generate `FooLexerRoundtrip.lean`. The support module is inferred from the
    lexer import: `a.FooLexer` uses `a.FooLexerRoundtripSupport`. It must define
    `renderTok : Tok → String` in the namespace with the same final component. -/
def generateRoundtripFrom (surface : Surface) (lexerImport lexerName roundtripModule : String) :
    Except String String := do
  let (_, mode, eofName) ← validateRoundtripLexer surface
  let tokTy := surface.tokenType
  let ruleCount := mode.rules.size
  let supportImport := lexerImport ++ "RoundtripSupport"
  let supportNamespace := (supportImport.splitOn ".").getLastD supportImport
  let memCases := String.intercalate " | " (List.replicate ruleCount "h")
  let textFlags := mode.rules.toList.map fun r => r.binder.isSome && r.emit.isSome
  let flagsLit := "#[" ++ String.intercalate ", " (textFlags.map boolLit) ++ "]"
  let textArms := String.intercalate "\n" <|
    ((List.zip (List.range textFlags.length) textFlags).map fun (i, dep) =>
      if dep then s!"  | {i}, h => simp at h" else s!"  | {i}, _ => rfl") ++
    [s!"  | (n+{ruleCount}), h => simp at h"]
  let headerImports :=
    if surface.header.isEmpty then "" else Builder.publicizeImports surface.header ++ "\n"
  let out :=
    s!"module\n" ++
    s!"-- Generated by leanparsergenerator: universal printer/lexer roundtrip theorem.\n" ++
    s!"import all {lexerImport}\n" ++
    s!"public import {supportImport}\n" ++
    s!"public import LeanParserGenerator.Lexer.Roundtrip\n" ++
    s!"meta import {lexerImport}\n" ++
    s!"meta import LeanParserGenerator.Lexer.Roundtrip\n" ++
    headerImports ++ "\n" ++
    s!"@[expose] public section\n\n" ++
    s!"namespace {roundtripModule}\n\n" ++
    s!"open Lexer\n\n" ++
    s!"abbrev RoundtrippableTok : {tokTy} → Prop :=\n" ++
    s!"  Lexer.RoundtrippableTok {lexerName}.lexer {supportNamespace}.renderTok ' '\n\n" ++
    s!"def render (ts : List {tokTy}) : String :=\n" ++
    s!"  Lexer.render {supportNamespace}.renderTok \" \" ts\n\n" ++
    s!"private theorem acts_start_eq :\n" ++
    s!"    {lexerName}.cflat.base.acts.getD {lexerName}.cflat.base.start #[] =\n" ++
    s!"      (({lexerName}.tokenizer.modes[0]'(by native_decide)).map (·.act)).toArray := by\n" ++
    s!"  have hacts : {lexerName}.cflat.base.acts =\n" ++
    s!"      {lexerName}.tokenizer.modes.map (fun rules => (rules.map (·.act)).toArray) := rfl\n" ++
    s!"  rw [hacts, show {lexerName}.cflat.base.start = 0 from rfl,\n" ++
    s!"    Lexer.getD_eq_getElem _ _ _ (by rw [Array.size_map]; native_decide), Array.getElem_map]\n\n" ++
    s!"private theorem actions_stay : ∀ (s : String) (rule : Nat),\n" ++
    s!"    ((({lexerName}.cflat.base.acts.getD {lexerName}.cflat.base.start #[]).getD rule\n" ++
    s!"      (fun _ => Lexer.Act.mk none Lexer.Trans.stay)) s).trans = Lexer.Trans.stay := by\n" ++
    s!"  intro s rule\n" ++
    s!"  rw [acts_start_eq]\n" ++
    s!"  apply Lexer.getD_act_trans_stay\n" ++
    s!"  intro x hx s'\n" ++
    s!"  rw [List.mem_toArray, List.mem_map] at hx\n" ++
    s!"  obtain ⟨r, hr, rfl⟩ := hx\n" ++
    s!"  simp only [{lexerName}.tokenizer, List.getElem_toArray, List.getElem_cons_zero,\n" ++
    s!"    List.mem_cons, List.not_mem_nil, or_false] at hr\n" ++
    s!"  rcases hr with {memCases} <;> subst h <;> rfl\n\n" ++
    s!"private theorem actions_text_independent : ∀ (rule : Nat),\n" ++
    s!"    {lexerName}.cflat.needsText {lexerName}.cflat.base.start rule = false →\n" ++
    s!"      ∀ (s : String),\n" ++
    s!"        (({lexerName}.cflat.base.acts.getD {lexerName}.cflat.base.start #[]).getD rule\n" ++
    s!"          (fun _ => Lexer.Act.mk none Lexer.Trans.stay)) s =\n" ++
    s!"        (({lexerName}.cflat.base.acts.getD {lexerName}.cflat.base.start #[]).getD rule\n" ++
    s!"          (fun _ => Lexer.Act.mk none Lexer.Trans.stay)) \"\" := by\n" ++
    s!"  intro rule hnt s\n" ++
    s!"  have hnt' : ({flagsLit} : Array Bool).getD rule true = false := hnt\n" ++
    s!"  rw [acts_start_eq]\n" ++
    s!"  match rule, hnt' with\n" ++ textArms ++ "\n\n" ++
    s!"private theorem separator_ok : Lexer.SeparatorOk {lexerName}.lexer ' ' := by\n" ++
    s!"  native_decide\n\n" ++
    s!"/-- Rendering and lexing any list of roundtrippable tokens returns that list,\n" ++
    s!"    followed by the lexer EOF token. -/\n" ++
    s!"theorem render_roundtrip (ts : List {tokTy}) (h : Lexer.Forall RoundtrippableTok ts) :\n" ++
    s!"    {lexerName}.tokenizeBare (render ts) = .ok (ts ++ [{tokTy}.{eofName}]) := by\n" ++
    s!"  unfold {lexerName}.tokenizeBare render\n" ++
    s!"  exact Lexer.tokenizeFlatStr_render {lexerName}.cflat {tokTy}.{eofName}\n" ++
    s!"    {supportNamespace}.renderTok ' ' (by native_decide) (by native_decide)\n" ++
    s!"    actions_stay actions_text_independent rfl separator_ok ts h\n\n" ++
    s!"end {roundtripModule}\n"
  return out

end Emit
