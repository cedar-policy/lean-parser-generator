module
/-
The Lean package that proves a generated Rust lexer and parser equal to the Lean ones
(`%option gen_rust_verif <dir>`, docs/RUST_PARSER.md).

This file renders the modules of that package that do not come from Aeneas: the lexer
certificate (`LexCert`), the parser and lexer proofs (`Proof`, `LexProof`), the root module
and the lakefile. The proofs are the same for every grammar except for names and sizes; the
generic part is in `rust/verif/` (`lpg_kernel.Proof.parse_lean`, `lpg_kernel.Proof.lex_run`). The
checks the proofs run are decided by the kernel, so nothing written here is trusted: a wrong
size or a wrong certificate makes the package fail to build.

`Emit/Rust/BridgeIO.lean` runs Charon and Aeneas and writes the files.
-/
public import LeanParserGenerator.Emit.Codegen
public import LeanParserGenerator.Emit.Rust.Lexer

@[expose] public section

namespace Emit.RustBridge

open Frontend Lexer Construct Emit.Rust

/-- The names a bridge package refers to. -/
structure Names where
  /-- The Lean module prefix of the bridge, e.g. `CedarRustBridge`. -/
  bridge : String
  /-- The Lean namespace Aeneas gives the Rust crate, e.g. `cedar_rust_parser`. -/
  crateNs : String
  /-- The Lean prefix of the generated Rust module, e.g. `generated.` (empty for the crate
      root). -/
  rustMod : String
  /-- The generated Lean parser: its module (`cedar.CedarParser`) and namespace
      (`CedarParser`). -/
  parserImport : String
  parserNs : String
  /-- The generated Lean lexer, if the grammar has one. -/
  lexerImport : String
  lexerNs : String

/-- Replace `@@KEY@@` by its value. -/
def fill (tmpl : String) (subst : List (String × String)) : String :=
  subst.foldl (fun acc (k, v) => acc.replace ("@@" ++ k ++ "@@") v) tmpl

/-- A natural number in hexadecimal. -/
def hex (n : Nat) : String := "0x" ++ String.ofList (Nat.toDigits 16 n)

def header (what : String) : String :=
  s!"-- Generated by LeanParserGenerator: {what}. DO NOT EDIT.\n"

/-! ### What the proofs cover -/

/-- Why the proofs do not cover a grammar, if they do not. -/
def coverage (s : Surface) : Except String Unit := do
  match s.lexer with
  | none => pure ()
  | some spec =>
    unless spec.modes.size == 1 do
      throw "the proofs cover lexers with one mode; this one has several"
    for r in spec.modes[0]!.rules do
      match r.trans with
      | .stay => pure ()
      | _ => throw "the proofs cover lexers whose rules stay in their mode"

/-! ### The lexer certificate -/

/-- The data of the Rust lexer, as the generator writes it (`renderLexer`): its tables, the
    Rust state of each state of the Lean DFA, and the terminal of each rule. -/
structure LexData where
  cls : Array Nat
  rows : Array (Array Nat)
  accept : Array Nat
  start : Nat
  acceptFrom : Nat
  phi : Array Nat
  ruleTerm : Array Nat
  /-- The rules whose terminal a Rust function computes. -/
  hooks : Array Nat
  /-- The intervals between the endpoints of the edge classes of the DFA. -/
  ivs : Array (Nat × Nat)
  numRules : Nat

/-- The terminal index of a token name, as in the generated `term` module. -/
def termIndex (s : Surface) (augEof : Nat) (name : String) : Nat :=
  match s.tokens.findIdx? (·.name == name) with
  | some i => if name == s.eof then augEof else i
  | none => 0

def lexData (s : Surface) (augEof : Nat) (spec : LexerSpec) : Except String LexData := do
  let mode := spec.modes[0]!
  let some (dfa, _) := DFA.build?WithVecs (mode.rules.map (·.regex))
    | throw "DFA construction ran out of fuel"
  let bd := ByteDFA.byteOfFlat (DFA.flatOfDFA dfa)
  let (cls, nc) := byteClasses bd
  let e := encodeMode bd cls nc
  let nRows := bd.nStates + 1
  let rows := (Array.range nRows).map fun k =>
    (Array.range nc).map fun c => e.trans.getD (k * nc + c) 0 / nc
  let accept := (Array.range nRows).map fun k => e.acceptAt.getD (k * nc) 0
  -- The boundary states of the byte DFA are the states of the Lean DFA, in order.
  let phi := (Array.range dfa.states.size).map fun s => e.newIdx.getD s 0 + 1
  let mut ruleTerm : Array Nat := #[]
  let mut hooks : Array Nat := #[]
  for h : ri in [0:mode.rules.size] do
    let act ← classifyLexAct s spec mode.rules[ri]
    match act with
    | .skip => ruleTerm := ruleTerm.push 65535
    | .const n | .lexeme n | .transform n _ => ruleTerm := ruleTerm.push (termIndex s augEof n)
    | .tokenFn _ => ruleTerm := ruleTerm.push 65534; hooks := hooks.push ri
  let mut cuts : Array Nat := #[0, 0x110000]
  for st in dfa.states do
    for tr in st.trans do
      for (lo, hi) in tr.cls.rs do
        if lo ≤ 0x10ffff then cuts := cuts.push lo
        if hi + 1 ≤ 0x10ffff then cuts := cuts.push (hi + 1)
  let sorted := cuts.qsort (· < ·)
  let mut uniq : Array Nat := #[]
  for c in sorted do
    if uniq.back? != some c then uniq := uniq.push c
  let ivs := (Array.range (uniq.size - 1)).map fun i => (uniq[i]!, uniq[i + 1]! - 1)
  return { cls, rows, accept, start := e.start / nc, acceptFrom := e.acceptFrom / nc, phi,
           ruleTerm, hooks, ivs, numRules := mode.rules.size }

def natList (xs : Array Nat) : String :=
  "[" ++ ", ".intercalate (xs.toList.map toString) ++ "]"

def renderLexCert (n : Names) (d : LexData) : String :=
  let nc := (d.rows.getD 0 #[]).size
  let clsP := d.cls.toList.zipIdx.foldl (fun acc (c, i) => acc ||| (c <<< (8 * i))) 0
  let transP := d.rows.toList.map fun row =>
    row.toList.zipIdx.foldl (fun acc (x, c) => acc ||| (x <<< (16 * c))) 0
  let accP := d.accept.toList.zipIdx.foldl (fun acc (x, i) => acc ||| (x <<< (16 * i))) 0
  header "the certificate of the lexer check" ++ "\n" ++
  "/-! The Rust lexer tables packed into numbers, the Rust state of each state of the Lean DFA,\n" ++
  "    and the intervals of the check (`Spec.lexSimCheck`). Nothing here is trusted. -/\n\n" ++
  s!"namespace {n.bridge}.LexCert\n" ++
  s!"def NC : Nat := {nc}\n" ++
  s!"def NR : Nat := {d.rows.size}\n" ++
  s!"def clsP : Nat := {hex clsP}\n" ++
  s!"def transP : List Nat := [" ++ ",\n  ".intercalate (transP.map hex) ++ "]\n" ++
  s!"def accP : Nat := {hex accP}\n" ++
  s!"def start : Nat := {d.start}\n" ++
  s!"def acceptFrom : Nat := {d.acceptFrom}\n" ++
  s!"def phi : List Nat := {natList d.phi}\n" ++
  s!"def ruleTerm : List Nat := {natList d.ruleTerm}\n" ++
  "def ivs : List (Nat × Nat) := [" ++
    ", ".intercalate (d.ivs.toList.map fun (a, b) => s!"({a}, {b})") ++ "]\n" ++
  s!"end {n.bridge}.LexCert\n"

/-! ### The parser proof -/

def parserTmpl : String := "/-!
The Rust parser runs the Lean parser's table (`@@PNS@@.table`).

The checks are decided by the kernel: the Rust tables extracted by Aeneas are well-formed, and
they are the tables of `@@PNS@@.flat`.
-/

open Aeneas Aeneas.Std Result
open lpg_kernel lpg_kernel.Proof @@CRATE@@

namespace @@CRATE@@.Proof

/-- The Rust parser tables, as numbers. -/
def rows : Spec.RustRows :=
  rowsOf @@RM@@ACTION @@RM@@GOTO @@RM@@DEFAULT_REDUCE @@RM@@LHS
    @@RM@@RHS_LEN @@RM@@EOF

theorem rows_wf : rows.Wf @@S@@ @@NT@@ @@NN@@ @@P@@ :=
  Spec.RustRows.wf_of_check (by decide +kernel)

theorem flags : (@@NT@@ : Nat) ≤ Spec.prodFlag ∧ (@@P@@ : Nat) ≤ Spec.prodFlag := by decide

@@TABLES@@

theorem defRed_eq : @@PNS@@.defRedData.toList = rows.defRed.map Spec.decodeOpt := by
  decide +kernel

theorem lhs_eq : @@PNS@@.lhsData.toList = rows.lhs := by decide +kernel

theorem len_eq : @@PNS@@.lenData.toList = rows.rhs := by decide +kernel

theorem eof_eq : @@PNS@@.flat.eof.1 = rows.eof := by decide +kernel

theorem same (e : Nat) (sem : Nat → List Nat → Nat) :
    Spec.SameAutomaton (rows.tables.exec e sem) @@PNS@@.flat.toExecTable @@S@@ @@NT@@ @@NN@@ @@P@@ :=
  Spec.sameAutomaton_flat rows @@PNS@@.flat rows_wf e sem rfl eof_eq rfl rfl
    act_eq goto_eq defRed_eq lhs_eq len_eq

/-- **The Rust parser is the Lean parser.** For tokens whose terminals are those of `input`,
    `parse` ends as the kernel's machine, whose run `R` corresponds to `Exec` (`RunSim`, with
    spans), and `2 ^ 62` steps of the tree table of `@@PNS@@.table` on `input` are `R` with
    each token index replaced by the token's value. By `Spec.run_eq_eval` and
    `Spec.run_of_stepN`, this is a statement about `Exec.run @@PNS@@.table input logN`. -/
theorem parse_lean (tokens : Slice Token) (stack : alloc.vec.Vec Entry)
    (nodes : alloc.vec.Vec Node) (hplat : System.Platform.numBits = 64)
    (input : List (Nat × @@PNS@@.VP))
    (hterms : ∀ t ∈ tokens.val, t.term.val < @@NT@@)
    (hin : input.map (·.1) = tokens.val.map (·.term.val)) :
    @@RM@@parse tokens stack nodes ⦃ res stack' nodes' =>
      ∃ (stop : Spec.MStop) (stk : List Spec.MEntry) (nd : List Spec.MNode)
        (R : Runtime.Exec.Result (Spec.Tree Nat) ⊕
          (Runtime.Exec.Stack (Spec.Tree Nat) × List (Nat × Spec.Tree Nat))),
        ResRel stop res ∧ stack'.val.map entryNat = stk ∧ nodes'.val.map nodeNat = nd ∧
        Spec.RunSim (tokens.val.map tokNat) (stop, stk, nd) R ∧
        Spec.stepN (Spec.treeTable @@PNS@@.table) (2 ^ 62) [] (Spec.treeInput input) =
          Spec.mapStep (Spec.Tree.map (Spec.leafVal @@PNS@@.table input)) R ⦄ := by
  unfold @@RM@@parse
  apply Aeneas.Std.WP.spec_bind (fuel_spec hplat)
  intro fuel hfuel
  have := lpg_kernel.Proof.parse_lean tokens stack nodes @@RM@@ACTION @@RM@@GOTO
    @@RM@@DEFAULT_REDUCE @@RM@@LHS @@RM@@RHS_LEN @@RM@@EOF fuel
    (by rw [hfuel]) hplat @@PNS@@.flat input rows_wf flags same hterms hin
  rw [hfuel] at this
  exact this

end @@CRATE@@.Proof
"

def compressedTables : String := "theorem buildDense_eq : @@@PNS@@.buildDense = @Spec.buildDense := rfl

theorem act_merge :
    Spec.mergeEq .error (rows.action.flatten.map Spec.decodeAct) @@PNS@@.actionCells.toList 0
      = true := by decide +kernel

theorem act_len : @@ASZ@@ = (rows.action.flatten.map Spec.decodeAct).length := by decide +kernel

theorem goto_merge :
    Spec.mergeEq none (rows.goto.flatten.map Spec.decodeOpt) @@PNS@@.gotoCells.toList 0
      = true := by decide +kernel

theorem goto_len : @@GSZ@@ = (rows.goto.flatten.map Spec.decodeOpt).length := by decide +kernel

theorem act_eq : @@PNS@@.flat.actionData.toList = rows.action.flatten.map Spec.decodeAct := by
  show (@@PNS@@.buildDense @@ASZ@@ .error @@PNS@@.actionCells).toList = _
  rw [buildDense_eq]
  exact Spec.buildDense_toList _ _ _ _ act_len act_merge

theorem goto_eq : @@PNS@@.flat.gotoData.toList = rows.goto.flatten.map Spec.decodeOpt := by
  show (@@PNS@@.buildDense @@GSZ@@ none @@PNS@@.gotoCells).toList = _
  rw [buildDense_eq]
  exact Spec.buildDense_toList _ _ _ _ goto_len goto_merge"

def denseTables : String := "theorem act_eq : @@PNS@@.flat.actionData.toList = rows.action.flatten.map Spec.decodeAct := by
  decide +kernel

theorem goto_eq : @@PNS@@.flat.gotoData.toList = rows.goto.flatten.map Spec.decodeOpt := by
  decide +kernel"

def renderProof (n : Names) (s : Surface) (prepared : PreparedGrammar) : String :=
  let g := prepared.augmented
  let numT := g.numTerminals
  let numN := g.numNonterminals
  let subst := [("PNS", n.parserNs), ("CRATE", n.crateNs), ("RM", n.rustMod),
    ("S", toString prepared.tables.numStates), ("NT", toString numT),
    ("NN", toString numN), ("P", toString g.prods.size),
    ("ASZ", toString (prepared.tables.numStates * numT)),
    ("GSZ", toString (prepared.tables.numStates * numN))]
  let tables := fill (if s.options.compressTables then compressedTables else denseTables) subst
  header "the proof that the Rust parser runs the Lean parser's table" ++ "\n" ++
  s!"import {n.parserImport}\nimport {n.bridge}.Funs\nimport Kernel.Tables\n\n" ++
  fill (parserTmpl.replace "@@TABLES@@" tables) subst

/-! ### The lexer proof -/

def lexerTmpl : String := "/-!
The Rust lexer runs the Lean lexer's DFA (`@@LNS@@.dfa0`).

The checks are decided by the kernel: the Rust lexer tables are within bounds (`LWf`), the
packed numbers of `LexCert` are the Aeneas tables, and the Rust DFA simulates `@@LNS@@.dfa0`
on UTF-8 (`Spec.lexSimCheck`). `lex_agrees` says that the Rust `lex` and
`Lexer.tokenize @@LNS@@.lexer` report the same rule-level run, and `tokens_agree` that their
tokens agree one by one.
-/

open Aeneas Aeneas.Std Result
open lpg_kernel lpg_kernel.Proof @@CRATE@@

namespace @@CRATE@@.Proof

theorem lex_wf : LWf (NR := @@NRULES@@#usize) @@RM@@LEX_CLASS @@RM@@LEX_TRANS @@RM@@LEX_ACCEPT
    @@RM@@LEX_START :=
  lwf_of_check _ _ _ _ (by decide +kernel)

theorem lex_pack : packCheck @@RM@@LEX_CLASS @@RM@@LEX_TRANS @@RM@@LEX_ACCEPT
    @@BR@@.LexCert.clsP @@BR@@.LexCert.transP @@BR@@.LexCert.accP = true := by decide +kernel

theorem lex_start : @@RM@@LEX_START.val = @@BR@@.LexCert.start := by decide +kernel

theorem lex_accept_from : @@RM@@LEX_ACCEPT_FROM.val = @@BR@@.LexCert.acceptFrom := by
  decide +kernel

theorem lex_dfa : lexDfaOf @@RM@@LEX_CLASS @@RM@@LEX_TRANS @@RM@@LEX_ACCEPT
      @@RM@@LEX_START @@RM@@LEX_ACCEPT_FROM =
    Spec.packedDfa @@BR@@.LexCert.NC @@BR@@.LexCert.NR @@BR@@.LexCert.clsP @@BR@@.LexCert.transP
      @@BR@@.LexCert.accP @@BR@@.LexCert.start @@BR@@.LexCert.acceptFrom := by
  rw [lexDfaOf_eq_packed _ _ _ _ _ _ _ _ lex_pack, lex_start, lex_accept_from]
  rfl

theorem lex_dead : deadCheck @@BR@@.LexCert.NC @@BR@@.LexCert.transP = true := by decide +kernel

/-- The Rust DFA, read from the packed numbers. -/
abbrev rustDfa : Spec.LexDFA :=
  Spec.packedDfa @@BR@@.LexCert.NC @@BR@@.LexCert.NR @@BR@@.LexCert.clsP
    @@BR@@.LexCert.transP @@BR@@.LexCert.accP @@BR@@.LexCert.start @@BR@@.LexCert.acceptFrom

/-! The simulation check runs in blocks of @@BLOCK@@ states, one declaration each, so that the
    kernel does not hold the reductions of all the states at once (`Spec.lexSimCheck_of_parts`). -/

theorem lex_sim_head : Spec.lexSimHead rustDfa @@LNS@@.dfa0 @@BR@@.LexCert.phi
    @@BR@@.LexCert.ivs = true := by decide +kernel

@@PARTS@@
theorem lex_simcheck : Spec.lexSimCheck rustDfa @@LNS@@.dfa0 @@BR@@.LexCert.phi
    @@BR@@.LexCert.ivs = true :=
  Spec.lexSimCheck_of_parts _ _ _ _ @@BLOCK@@ @@NPARTS@@ (by decide +kernel) lex_sim_head
    (fun i hi => by
      interval_cases i
      exacts [@@PARTNAMES@@])

theorem lex_sim : Spec.LexSim (lexDfaOf @@RM@@LEX_CLASS @@RM@@LEX_TRANS
    @@RM@@LEX_ACCEPT @@RM@@LEX_START @@RM@@LEX_ACCEPT_FROM) @@LNS@@.dfa0
    (fun s => @@BR@@.LexCert.phi.getD s 0) := by
  rw [lex_dfa]
  exact Spec.lexSim_of_check _ _ _ _ lex_simcheck (packed_dead _ _ _ _ _ _ _ lex_dead)

theorem lexer_dfa : @@LNS@@.lexer.dfas.getD 0 default = @@LNS@@.dfa0 := rfl

theorem lexer_start : @@LNS@@.lexer.start = 0 := rfl

/-- The actions of the lexer stay in its one mode. -/
theorem lexer_stay : ∀ (s : String) (rule : Nat),
    (((@@LNS@@.lexer.acts.getD 0 #[]).getD rule (fun _ => {})) s).trans = Lexer.Trans.stay := by
  intro s rule
  have hacts : @@LNS@@.lexer.acts.getD 0 #[] =
      ((@@LNS@@.tokenizer.modes[0]'(by decide)).map (·.act)).toArray := by
    have : @@LNS@@.lexer.acts =
        @@LNS@@.tokenizer.modes.map (fun rules => (rules.map (·.act)).toArray) := rfl
    rw [this, Array.getD_eq_getD_getElem?, Array.getElem?_map,
      Array.getElem?_eq_getElem (by decide)]
    rfl
  rw [hacts]
  apply Lexer.getD_act_trans_stay
  intro x hx s'
  rw [List.mem_toArray, List.mem_map] at hx
  obtain ⟨r, hr, rfl⟩ := hx
  simp only [@@LNS@@.tokenizer, List.getElem_toArray, List.getElem_cons_zero,
    List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with @@ALTS@@ <;> subst h <;> rfl

/-- The Lean lexer reports the rule-level run of `@@LNS@@.dfa0`. -/
theorem tokenize_run (input : String) :
    Spec.LeanOut @@LNS@@.lexer 0 []
      (Spec.ruleRun @@LNS@@.dfa0 (input.toList.length + 1) input.toList 0)
      (Lexer.tokenize @@LNS@@.lexer input) := by
  have := Spec.tokenize_rules @@LNS@@.lexer 0 lexer_stay (input.toList.length + 1)
    input.toList 0 0 []
  rw [lexer_dfa] at this
  unfold Lexer.tokenize
  rw [lexer_start]
  exact this

/-- **The Rust lexer is the Lean lexer.** On the UTF-8 bytes of `input` (at most `u32::MAX` of
    them), the Rust `lex` and `Lexer.tokenize @@LNS@@.lexer input` report the same run of
    `@@LNS@@.dfa0` (`Spec.ruleRun`): the Rust result is `Spec.rustOut` of it (the tokens of the
    rules that are not skipped, with their byte spans, then the end-of-input token, or the byte
    position of the error), and the Lean result is `Spec.LeanOut` of it. -/
theorem lex_agrees (input : String) (src : Slice U8) (out : alloc.vec.Vec Token)
    (hsrc : bytesOf src = Spec.encChars input.toList) (hlen : src.val.length ≤ 2 ^ 32 - 1)
    (hroom : out.val.length + src.val.length < Usize.max) :
    @@RM@@lex src out ⦃ res out' =>
      LexRel (Spec.rustOut (lexTablesOf @@RM@@LEX_CLASS @@RM@@LEX_TRANS
          @@RM@@LEX_ACCEPT @@RM@@LEX_START @@RM@@LEX_ACCEPT_FROM @@RM@@RULE_TERM
          @@RM@@EOF) src.val.length (out.val.map ltokNat)
          (Spec.ruleRun @@LNS@@.dfa0 (input.toList.length + 1) input.toList 0)).1 res ∧
      out'.val.map ltokNat = (Spec.rustOut (lexTablesOf @@RM@@LEX_CLASS @@RM@@LEX_TRANS
          @@RM@@LEX_ACCEPT @@RM@@LEX_START @@RM@@LEX_ACCEPT_FROM @@RM@@RULE_TERM
          @@RM@@EOF) src.val.length (out.val.map ltokNat)
          (Spec.ruleRun @@LNS@@.dfa0 (input.toList.length + 1) input.toList 0)).2 ∧
      Spec.LeanOut @@LNS@@.lexer 0 []
          (Spec.ruleRun @@LNS@@.dfa0 (input.toList.length + 1) input.toList 0)
          (Lexer.tokenize @@LNS@@.lexer input) ⦄ := by
  unfold @@RM@@lex
  refine Aeneas.Std.WP.spec_mono
    (lex_run src out _ _ _ _ _ _ _ lex_wf @@LNS@@.dfa0 _ lex_sim input.toList hsrc hlen hroom) ?_
  rintro ⟨res, out'⟩ ⟨h1, h2⟩
  exact ⟨h1, h2, tokenize_run input⟩

/-! ### Token by token -/

theorem rule_term_list : @@RM@@RULE_TERM.val.map (·.val) = @@BR@@.LexCert.ruleTerm := by
  decide +kernel

theorem rule_term_cell (r : Nat) :
    cell1 @@RM@@RULE_TERM r 0 = (@@BR@@.LexCert.ruleTerm[r]?).getD 0 := by
  rw [cell1_eq, rule_term_list]

/-- The rules of the Lean DFA are the rules of the lexer. -/
theorem dfa_rules : ∀ (s r : Nat), (@@LNS@@.dfa0.states[s]!).accept = some r → r < @@NRULES@@ := by
  intro s r h
  have hall : @@LNS@@.dfa0.states.toList.all (fun st => match st.accept with
      | some r => decide (r < @@NRULES@@) | none => true) = true := by decide +kernel
  by_cases hs : s < @@LNS@@.dfa0.states.size
  · have hm : @@LNS@@.dfa0.states[s]! ∈ @@LNS@@.dfa0.states.toList := by
      simp [hs]
    have := (List.all_eq_true.mp hall) _ hm
    rw [h] at this
    simpa using this
  · have : @@LNS@@.dfa0.states[s]! = default := by
      simp [hs]
    rw [this] at h; cases h

/-- What a rule's action emits, against its entry of `RULE_TERM`: nothing for a skipped rule,
    a token otherwise. -/
theorem rule_emit (r : Nat) (hr : r < @@NRULES@@) (s : String) :
    (((@@LNS@@.lexer.acts.getD 0 #[]).getD r (fun _ => {})) s).emit =
      none ↔ (@@BR@@.LexCert.ruleTerm[r]?).getD 0 = Spec.termSkip := by
  interval_cases r <;>
    simp [@@LNS@@.lexer, @@LNS@@.tokenizer, @@BR@@.LexCert.ruleTerm, Spec.termSkip]

/-- The rules whose terminal a Rust function computes. -/
def hooks : List Nat := @@HOOKS@@

/-- The terminal of the token of a rule whose terminal is in `RULE_TERM`. -/
theorem rule_tok (r : Nat) (hr : r < @@NRULES@@) (hh : r ∉ hooks) (s : String) (tok : @@TOK@@)
    (h : (((@@LNS@@.lexer.acts.getD 0 #[]).getD r (fun _ => {})) s).emit = some tok) :
    (@@BR@@.LexCert.ruleTerm[r]?).getD 0 = @@PNS@@.termOf tok := by
  interval_cases r <;> simp [@@LNS@@.lexer, @@LNS@@.tokenizer, hooks] at h hh <;> subst h <;> rfl

/-- **The tokens of the two lexers, one by one.** For a run without error, the Rust tokens and
    the Lean tokens are in one-to-one order, with the same terminal, except for the tokens of the
    rules in `hooks`, whose terminal the Rust function of the rule computes after `lex`. -/
theorem tokens_agree (input : String) (rs : List Spec.RTok)
    (hrun : Spec.ruleRun @@LNS@@.dfa0 (input.toList.length + 1) input.toList 0 = (none, rs)) :
    Spec.Rel2 (fun (lt : Spec.LTok) (tok : @@TOK@@) => lt.rule ∈ hooks ∨ lt.term = @@PNS@@.termOf tok)
      (rs.filterMap (Spec.toLTok (lexTablesOf @@RM@@LEX_CLASS @@RM@@LEX_TRANS
        @@RM@@LEX_ACCEPT @@RM@@LEX_START @@RM@@LEX_ACCEPT_FROM @@RM@@RULE_TERM
        @@RM@@EOF)))
      (rs.filterMap (Spec.emitOf @@LNS@@.lexer 0)) := by
  apply Spec.filterMap_rel2
  intro m hm
  have hm' : m ∈ (Spec.ruleRun @@LNS@@.dfa0 (input.toList.length + 1) input.toList 0).2 := by
    rw [hrun]; exact hm
  obtain ⟨s, hs⟩ := Spec.ruleRun_rule _ _ _ _ m hm'
  have hr := dfa_rules s m.rule hs
  have he := rule_emit m.rule hr (String.ofList m.text)
  have hterm : (lexTablesOf @@RM@@LEX_CLASS @@RM@@LEX_TRANS @@RM@@LEX_ACCEPT
      @@RM@@LEX_START @@RM@@LEX_ACCEPT_FROM @@RM@@RULE_TERM @@RM@@EOF).ruleTerm
      m.rule = (@@BR@@.LexCert.ruleTerm[m.rule]?).getD 0 := rule_term_cell m.rule
  constructor
  · unfold Spec.toLTok Spec.emitOf
    rw [hterm]
    by_cases hk : (@@BR@@.LexCert.ruleTerm[m.rule]?).getD 0 = Spec.termSkip
    · rw [he.mpr hk]; simp [hk]
    · cases hx : (((@@LNS@@.lexer.acts.getD 0 #[]).getD m.rule (fun _ => {}))
          (String.ofList m.text)).emit with
      | none => exact absurd (he.mp hx) hk
      | some _ => simp [hk]
  · intro lt tok h1 h2
    unfold Spec.toLTok at h1
    rw [hterm] at h1
    split at h1
    · simp only [Option.some.injEq] at h1
      subst h1
      by_cases h5 : m.rule ∈ hooks
      · exact Or.inl h5
      · exact Or.inr (rule_tok m.rule hr h5 _ tok h2)
    · cases h1

end @@CRATE@@.Proof
"

/-- The number of Lean DFA states per block of the simulation check. The kernel keeps its
    reductions until the end of a declaration, so its memory grows with the states of a block:
    one check over all 387 states of a 93-rule lexer went past 30 GB, blocks of 32 keep the
    whole package build under 12 GB. -/
def lexSimBlock : Nat := 32

def renderLexProof (n : Names) (s : Surface) (d : LexData) : String :=
  let alts := " | ".intercalate ((List.range d.numRules).map fun _ => "h")
  let nparts := max 1 ((d.phi.size + lexSimBlock - 1) / lexSimBlock)
  let parts := String.join ((List.range nparts).map fun i =>
    s!"theorem lex_sim_part_{i} : Spec.lexSimPart rustDfa {n.lexerNs}.dfa0 " ++
    s!"{n.bridge}.LexCert.phi\n    {n.bridge}.LexCert.ivs ({i} * {lexSimBlock}) {lexSimBlock} = true := " ++
    "by decide +kernel\n\n")
  let partNames := ", ".intercalate ((List.range nparts).map fun i => s!"lex_sim_part_{i}")
  header "the proof that the Rust lexer runs the Lean lexer's DFA" ++ "\n" ++
  s!"import {n.lexerImport}\nimport {n.parserImport}\nimport {n.bridge}.Funs\n" ++
  s!"import {n.bridge}.LexCert\nimport Kernel.LexTables\n" ++
  "import LeanParserGenerator.Lexer.Roundtrip\nimport Mathlib.Tactic.IntervalCases\n\n" ++
  fill (lexerTmpl.replace "@@PARTS@@" parts) [("LNS", n.lexerNs), ("PNS", n.parserNs),
    ("CRATE", n.crateNs), ("RM", n.rustMod), ("BR", n.bridge),
    ("NRULES", toString d.numRules), ("ALTS", alts), ("HOOKS", natList d.hooks),
    ("TOK", s.tokenType), ("BLOCK", toString lexSimBlock), ("NPARTS", toString nparts),
    ("PARTNAMES", partNames)]

/-! ### The package -/

def renderRoot (n : Names) (hasLexer : Bool) : String :=
  header "the root module of the proof package" ++ "\n" ++
  s!"import {n.bridge}.Proof\n" ++ (if hasLexer then s!"import {n.bridge}.LexProof\n" else "")

/-- The lakefile. `verif` is the generator's proof package, relative to the bridge. -/
def renderLakefile (n : Names) (verif : String) : String :=
  "-- Generated by LeanParserGenerator (`%option gen_rust_verif`); written once, edit freely.\n" ++
  "import Lake\nopen Lake DSL\n\n" ++
  "/-- The proof that the generated Rust lexer and parser are the Lean ones. The generic\n" ++
  "    proofs are the generator's `verif` package; its packages (Aeneas, Mathlib) are shared,\n" ++
  "    so that they are built once. The generated Lean modules of the grammar must be\n" ++
  "    reachable: add a `require` of their package if it is not the generator's. -/\n" ++
  s!"package «{n.bridge}» where\n" ++
  s!"  packagesDir := \"{verif}/.lake/packages\"\n\n" ++
  s!"require «LeanParserGeneratorVerif» from \"{verif}\"\n\n" ++
  s!"@[default_target]\nlean_lib «{n.bridge}» where\n"

end Emit.RustBridge
