def gotoTable' (s : St) (nt : NonTerminal) :
    Option { s : NonInitState // Symbol.NT nt = lastSymb' s } :=
  match packedField (gotoRows.getD (stateRow s) 0) 6 nt.val with
  | 0 => none
  | c + 1 =>
    if hs : c < 54 then
      (if h : Symbol.NT nt = lastSymb' ⟨c, hs⟩ then some ⟨⟨c, hs⟩, h⟩ else none)
    else none

