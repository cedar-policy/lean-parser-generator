    (Runtime.instNumberedFin 8)
    (Runtime.instNumberedFin 23)) candidate
    (startNt' (⟨0, of_decide_eq_true rfl⟩ : InitState))
    (⟨22, of_decide_eq_true rfl⟩ : Terminal)

theorem verifiedGrammarView_agrees :
    verifiedGrammarViewStructuralCheck verifiedGrammarView = true ∧
    verifiedGrammarView.tokenMappings.map (·.token) = ["SKIP", "IF", "THEN", "ELSE", "WHILE", "DO", "TRUE", "FALSE", "NOT", "AND", "ASSIGN", "SEMI", "LPAR", "RPAR", "PLUS", "MINUS", "TIMES", "LE", "EQ", "ID", "NUM", "EOF"] ∧
    (∀ token : Tok,
      verifiedGrammarView.tokenTerminal (tokenName' token) =
        some (tokenTerm' token).val) := by
  constructor
  · native_decide
  · constructor
    · native_decide
    · intro token
      cases token <;> rfl

