    | stk => (Runtime.Exec.popN (lenData.getD 8 0) stk).map (fun r => (sem 8 r.1, r.2))
  | 9 => fun stk => match stk with
    | (_, __s0, _) :: __tail => some ((__s0, .v1 (BExp.fls)), __tail)
