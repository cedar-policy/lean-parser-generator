@[export cedarentitiesparser_run]
def run (input : List (Runtime.Positioned Tok)) (logNSteps : Nat := 20) : Runtime.Exec.Result VP :=
  Runtime.Exec.runFast (ops := stackOps) flat fuse termOf input logNSteps

@[export cedarentitiesparser_parse]
def parse (input : List (Runtime.Positioned Tok)) (logNSteps : Nat := 20) : Option Entities :=
  match run input logNSteps with
  | .ok (_, .v0 r) => some r
  | _ => none

/-- The readable name of a terminal index (EOF is "end of input"). -/
def terminalName : Nat → String
  | 0 => "NAMESPACE"
  | 1 => "INSTANCE"
  | 2 => "IN"
  | 3 => "TAGS"
  | 4 => "TRUE"
  | 5 => "FALSE"
  | 6 => "LBRACE"
  | 7 => "RBRACE"
  | 8 => "SEMICOLON"
  | 9 => "COLON"
  | 10 => "LBRACKET"
  | 11 => "RBRACKET"
  | 12 => "LPAREN"
  | 13 => "RPAREN"
  | 14 => "COLONCOLON"
  | 15 => "COMMA"
  | 16 => "EQUALS"
  | 17 => "MINUS"
  | 18 => "IDENTIFIER"
  | 19 => "NUMBER"
  | 20 => "STRINGLIT"
  | 21 => "EOF"
  | 22 => "end of input"
  | n => s!"terminal {n}"

/-- Diagnose a parse: on rejection, the offending token index and expected set. -/
def diagnose (input : List (Runtime.Positioned Tok)) (logNSteps : Nat := 20) :
    Runtime.Exec.Diagnostic VP :=
  Runtime.Exec.diagnose table 23 (input.map decode) logNSteps

/-- Diagnose, also recovering the offending token's source span for line:col. -/
def diagnoseSpanned (input : List (Runtime.Positioned Tok)) (logNSteps : Nat := 20) :
    Runtime.Exec.Diagnostic VP × Option Runtime.Span :=
  Runtime.Exec.diagnoseSpanned table 23 (fun (sp, _) => some sp) (input.map decode) logNSteps

/-- A human-readable syntax-error message, or `none` when the input parses.
    Pass `source` to render `line:col`; `messages` overrides per-state text. -/
def errorMessage (input : List (Runtime.Positioned Tok)) (source : String := "")
    (messages : Nat → Option String := fun _ => none) (logNSteps : Nat := 20) : Option String :=
  match diagnoseSpanned input logNSteps with
  | (.error e, span) => some (e.formatWithSource span source terminalName messages)
  | _ => none

end CedarEntitiesParser

