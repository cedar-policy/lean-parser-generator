def prodLhs' : Production → NonTerminal :=
  fun p => (prodContents' p).1.1

def prodRhsRev' : Production → List (Symbol Terminal NonTerminal) :=
  fun p => (prodContents' p).1.2

def prodAction' : (p : Production) → arrowsRight (semT' (.NT (prodLhs' p))) ((prodRhsRev' p).map semT') :=
  fun p => (prodContents' p).2

