module
-- Generated by leanparsergenerator: parser roundtrip (token-generation inverse).
--
-- WHAT IS PROVEN (all hole-free, `native_decide`; see `#eval guarantees` below):
--   roundtrip_corpus       : parse (unparse t) = some t, for every t in `corpus`.
--   formatter_idempotence  : formatting unparse-tokens with space/newline/tab
--                            re-lexes to the same tokens (+ EOF).
--   full_roundtrip_corpus  : parse (lex (format (unparse t))) = t, for every t.
-- There are NO `sorry`s: the guarantee is over the ASTs you list in `corpus`,
-- not all ASTs (a universal inverse would invert the LR automaton). To extend a
-- guarantee, add witnesses to `corpus` — that is the whole specification.
public import cedarschema.CedarSchemaLexer
public import cedarschema.CedarSchemaParser
public import cedarschema.CedarSchemaUnparse
meta import cedarschema.CedarSchemaLexer
meta import cedarschema.CedarSchemaParser
meta import cedarschema.CedarSchemaUnparse

public import cedarschema.CedarSchemaAst
open CedarSchema


@[expose] public section

namespace CedarSchemaParserRoundtrip

open Lexer Runtime CedarSchemaUnparse

/-- Generate the token list of an AST with the user's `unparse`, then parse it
    back. The roundtrip asks this to return `some t` on the AST `t`. The tokens
    carry dummy spans (`parse` consumes `Positioned Tok`). -/
def parseRoundtrip (t : Schema) : Option Schema :=
  CedarSchemaParser.parse ((unparseSchema t).map Positioned.dummy) 30

/-- The witness corpus. **This is the whole specification**: the ASTs the
    roundtrip is proven for. It lives in your `CedarSchemaUnparse` module as
    `corpus` (so regeneration never overwrites your witnesses); add ASTs there
    and the theorems below cover them with no other change. Each entry is checked
    by `native_decide`. -/
abbrev corpus : List Schema := CedarSchemaUnparse.corpus

/-- **Proven (hole-free).** Every AST in `corpus` generates-and-reparses to
    itself: `parse (unparse t) = some t`. `native_decide`. -/
theorem roundtrip_corpus :
    corpus.all (fun t => parseRoundtrip t == some t) = true := by native_decide

/-! ### Formatter idempotence and the full roundtrip

`format sep` renders a token list with `renderTok` and a whitespace separator
after each token. Formatter idempotence is that re-lexing the formatted stream
recovers the tokens (+ EOF): adding whitespace does not change the roundtrip. It
holds because `renderTok` is complete and the lexer skips whitespace. The full
roundtrip composes it with the token-level parser roundtrip. -/

/-- Format a token list: each token's rendered text followed by the separator. -/
def format (sep : String) (ts : List Tok) : String :=
  ts.foldr (fun t acc => renderTok t ++ sep ++ acc) ""

/-- Re-lex a formatted token stream back to tokens (dropping the lexer error). -/
def relex (sep : String) (ts : List Tok) : Option (List Tok) :=
  (CedarSchemaLexer.tokenizeBare (format sep ts)).toOption

/-- **Proven (hole-free).** For every AST in `corpus`, formatting its token
    stream with a space, a newline, or a tab all re-lex to the same tokens + EOF
    — adding whitespace does not change what the lexer recovers. `native_decide`. -/
theorem formatter_idempotence :
    corpus.all (fun t =>
      let toks := unparseSchema t
      (relex " " toks == some (toks ++ [Tok.EOF]))
        && (relex "\n" toks == relex " " toks)
        && (relex "\t" toks == relex " " toks)) = true := by native_decide

/-- Full AST↔source roundtrip: generate tokens, format them to source with the
    separator, lex, and parse. The composition of the token-level parser
    roundtrip with the lexer roundtrip (formatter idempotence). -/
def fullRoundtrip (sep : String) (t : Schema) : Option Schema :=
  (relex sep (unparseSchema t)).bind (fun toks => CedarSchemaParser.parse (toks.map Positioned.dummy) 30)

/-- **Proven (hole-free).** Every AST in `corpus` survives the full AST→tokens→
    source→tokens→AST roundtrip, for a space and a newline separator.
    `native_decide`. -/
theorem full_roundtrip_corpus :
    corpus.all (fun t =>
      (fullRoundtrip " " t == some t) && (fullRoundtrip "\n" t == some t)) = true := by
  native_decide

/-- A human-readable summary of what this module proves, for the ASTs in
    `corpus`. Run `#eval guarantees` to print it. -/
def guarantees : String :=
  "CedarSchemaParserRoundtrip: proven hole-free for every t in `corpus`:\n  roundtrip_corpus       : parse (unparse t) = some t\n  formatter_idempotence  : relex (format (unparse t)) = tokens ++ EOF  (space/newline/tab)\n  full_roundtrip_corpus  : parse (lex (format (unparse t))) = some t"

-- `#eval guarantees` prints the proven roundtrip facts; the corpus size is how
-- many ASTs those facts currently cover.
#eval guarantees
#eval s!"corpus size: {corpus.length}"

end CedarSchemaParserRoundtrip
