def renderTok : Tok → String
  | .COMMA => ","
  | .SEMICOLON => ";"
  | .COLON => ":"
  | .COLONCOLON => "::"
  | .LBRACE => "{"
  | .RBRACE => "}"
  | .LBRACKET => "["
  | .RBRACKET => "]"
  | .LANGLE => "<"
  | .RANGLE => ">"
  | .EQUALS => "="
  | .QUESTION => "?"
  | .AT => "@"
  | .LPAREN => "("
  | .RPAREN => ")"
  | _ => ""

def render (ts : List Tok) : String := ts.foldr (fun t acc => renderTok t ++ " " ++ acc) ""

