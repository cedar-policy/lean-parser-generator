theorem reachable_NUMBER : ∃ v, ReachableTok (Tok.NUMBER v) := by
  refine ⟨?v, "0 ", ?rest, ?eq⟩
  case v => exact (match CedarSchemaLexer.tokenizeBare "0 " with
    | .ok (Tok.NUMBER v :: _) => v | _ => default)
  case rest => exact (match CedarSchemaLexer.tokenizeBare "0 " with
    | .ok (_ :: r) => r | _ => [])
  case eq => native_decide

