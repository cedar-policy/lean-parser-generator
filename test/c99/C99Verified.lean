    verifiedGrammarView.tokenMappings.map (·.token) = ["VOID", "CHAR", "SHORT", "INT", "LONG", "FLOAT", "DOUBLE", "SIGNED", "UNSIGNED", "BOOL", "COMPLEX", "STRUCT", "UNION", "ENUM", "CONST", "RESTRICT", "VOLATILE", "TYPEDEF", "EXTERN", "STATIC", "AUTO", "REGISTER", "INLINE", "CASE", "DEFAULT", "IF", "ELSE", "SWITCH", "WHILE", "DO", "FOR", "GOTO", "CONTINUE", "BREAK", "RETURN", "SIZEOF", "IDENTIFIER", "TYPEDEF_NAME", "CONSTANT", "STRING_LITERAL", "LBRACKET", "RBRACKET", "LPAREN", "RPAREN", "LBRACE", "RBRACE", "DOT", "ARROW", "INC", "DEC", "AMP", "STAR", "PLUS", "MINUS", "TILDE", "BANG", "SLASH", "PERCENT", "LSHIFT", "RSHIFT", "LT", "GT", "LEQ", "GEQ", "EQEQ", "NEQ", "CARET", "PIPE", "ANDAND", "OROR", "QUESTION", "COLON", "SEMICOLON", "ELLIPSIS", "EQ", "STAR_EQ", "SLASH_EQ", "PERCENT_EQ", "PLUS_EQ", "MINUS_EQ", "LSHIFT_EQ", "RSHIFT_EQ", "AMP_EQ", "CARET_EQ", "PIPE_EQ", "COMMA", "EOF"] ∧
    (∀ token : Tok,
      verifiedGrammarView.tokenTerminal (tokenName' token) =
        some (tokenTerm' token).val) := by
  constructor
  · native_decide
  · constructor
    · native_decide
    · intro token
      cases token <;> rfl

theorem safetyValidation : safeValidator (A := automatonInst) = true := by native_decide

theorem safety : Safe := safe_of_safeValidator safetyValidation

theorem completenessValidation : completeValidator (A := automatonInst) = true := by native_decide

theorem completeness : Complete := complete_of_completeValidator completenessValidation

def toStream (input : List Tok) : Runtime.NatStream Tok :=
  fun n => input.getD n .EOF
def parse (input : List Tok) (logNSteps : Nat := 40) : Option TranslationUnit :=
  match Runtime.parse (S := Runtime.NatStream _) (⟨0, of_decide_eq_true rfl⟩ : InitState) (toStream input) logNSteps with
  | .Parsed r _ => some r
  | _ => none

