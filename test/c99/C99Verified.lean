def decodeItems (row : Nat) : List Item :=
  (List.range (packedField row 100 0)).map fun i =>
    let item := packedField row 100 (i + 1)
    ⟨Fin.ofNat 184 (item % (1 <<< 8)),
     (item >>> 8) % (1 <<< 4),
     (List.range 88).filterMap fun t =>
       if ((item >>> 12) >>> t) % 2 = 1 then some (Fin.ofNat 88 t) else none⟩

def itemTable : Array (List Item) := itemRows.map decodeItems

def items' (s : St) : List Item := itemTable.getD (stateRow s) []
