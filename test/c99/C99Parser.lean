@[export c99parser_run]
def run (input : List (Runtime.Positioned Tok)) (logNSteps : Nat := 20) : Runtime.Exec.Result VP :=
  Runtime.Exec.runFast (ops := stackOps) flat fuse termOf input logNSteps

@[export c99parser_parse]
def parse (input : List (Runtime.Positioned Tok)) (logNSteps : Nat := 20) : Option TranslationUnit :=
  match run input logNSteps with
  | .ok (_, .v0 r) => some r
  | _ => none

/-- The readable name of a terminal index (EOF is "end of input"). -/
def terminalName : Nat → String
  | 0 => "VOID"
  | 1 => "CHAR"
  | 2 => "SHORT"
  | 3 => "INT"
  | 4 => "LONG"
  | 5 => "FLOAT"
  | 6 => "DOUBLE"
  | 7 => "SIGNED"
  | 8 => "UNSIGNED"
  | 9 => "BOOL"
  | 10 => "COMPLEX"
  | 11 => "STRUCT"
  | 12 => "UNION"
  | 13 => "ENUM"
  | 14 => "CONST"
  | 15 => "RESTRICT"
  | 16 => "VOLATILE"
  | 17 => "TYPEDEF"
  | 18 => "EXTERN"
  | 19 => "STATIC"
  | 20 => "AUTO"
  | 21 => "REGISTER"
  | 22 => "INLINE"
  | 23 => "CASE"
  | 24 => "DEFAULT"
  | 25 => "IF"
  | 26 => "ELSE"
  | 27 => "SWITCH"
  | 28 => "WHILE"
  | 29 => "DO"
  | 30 => "FOR"
  | 31 => "GOTO"
  | 32 => "CONTINUE"
  | 33 => "BREAK"
  | 34 => "RETURN"
  | 35 => "SIZEOF"
  | 36 => "IDENTIFIER"
  | 37 => "TYPEDEF_NAME"
  | 38 => "CONSTANT"
  | 39 => "STRING_LITERAL"
  | 40 => "LBRACKET"
  | 41 => "RBRACKET"
  | 42 => "LPAREN"
  | 43 => "RPAREN"
  | 44 => "LBRACE"
  | 45 => "RBRACE"
  | 46 => "DOT"
  | 47 => "ARROW"
  | 48 => "INC"
  | 49 => "DEC"
  | 50 => "AMP"
  | 51 => "STAR"
  | 52 => "PLUS"
  | 53 => "MINUS"
  | 54 => "TILDE"
  | 55 => "BANG"
  | 56 => "SLASH"
  | 57 => "PERCENT"
  | 58 => "LSHIFT"
  | 59 => "RSHIFT"
  | 60 => "LT"
  | 61 => "GT"
  | 62 => "LEQ"
  | 63 => "GEQ"
  | 64 => "EQEQ"
  | 65 => "NEQ"
  | 66 => "CARET"
  | 67 => "PIPE"
  | 68 => "ANDAND"
  | 69 => "OROR"
  | 70 => "QUESTION"
  | 71 => "COLON"
  | 72 => "SEMICOLON"
  | 73 => "ELLIPSIS"
  | 74 => "EQ"
  | 75 => "STAR_EQ"
  | 76 => "SLASH_EQ"
  | 77 => "PERCENT_EQ"
  | 78 => "PLUS_EQ"
  | 79 => "MINUS_EQ"
  | 80 => "LSHIFT_EQ"
  | 81 => "RSHIFT_EQ"
  | 82 => "AMP_EQ"
  | 83 => "CARET_EQ"
  | 84 => "PIPE_EQ"
  | 85 => "COMMA"
  | 86 => "EOF"
  | 87 => "end of input"
  | n => s!"terminal {n}"

/-- Diagnose a parse: on rejection, the offending token index and expected set. -/
def diagnose (input : List (Runtime.Positioned Tok)) (logNSteps : Nat := 20) :
    Runtime.Exec.Diagnostic VP :=
  Runtime.Exec.diagnose table 88 (input.map decode) logNSteps

/-- Diagnose, also recovering the offending token's source span for line:col. -/
def diagnoseSpanned (input : List (Runtime.Positioned Tok)) (logNSteps : Nat := 20) :
    Runtime.Exec.Diagnostic VP × Option Runtime.Span :=
  Runtime.Exec.diagnoseSpanned table 88 (fun (sp, _) => some sp) (input.map decode) logNSteps

/-- A human-readable syntax-error message, or `none` when the input parses.
    Pass `source` to render `line:col`; `messages` overrides per-state text. -/
def errorMessage (input : List (Runtime.Positioned Tok)) (source : String := "")
    (messages : Nat → Option String := fun _ => none) (logNSteps : Nat := 20) : Option String :=
  match diagnoseSpanned input logNSteps with
  | (.error e, span) => some (e.formatWithSource span source terminalName messages)
  | _ => none

end C99Parser

