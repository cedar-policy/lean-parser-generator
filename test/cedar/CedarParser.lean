theorem Stk.toList_ofList (l : Runtime.Exec.Stack VP) : (Stk.ofList l).toList = l := by
  induction l with
  | nil => rfl
  | cons hd tl ih =>
    obtain ⟨st, sp, v⟩ := hd
    cases v <;> (simp only [Stk.ofList, Stk.toList, ih]; try rfl)

