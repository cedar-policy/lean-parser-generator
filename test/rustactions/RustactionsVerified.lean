def decodeItems (row : Nat) : List Item :=
  (List.range (packedField row 27 0)).map fun i =>
    let item := packedField row 27 (i + 1)
    ⟨Fin.ofNat 27 (item % (1 <<< 5)),
     (item >>> 5) % (1 <<< 3),
     (List.range 19).filterMap fun t =>
       if ((item >>> 8) >>> t) % 2 = 1 then some (Fin.ofNat 19 t) else none⟩

