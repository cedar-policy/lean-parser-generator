    #[13, 13, 0, 13, 13, 0, 0, 13], #[0, 0, 8, 0, 0, 10, 0, 0], #[15, 15, 15, 15, 15, 15, 15, 15],
    #[0, 0, 8, 0, 0, 10, 0, 0], #[0, 0, 8, 0, 0, 10, 0, 0], #[12, 0, 0, 28, 0, 0, 0, 0],
    #[1, 16, 0, 1, 18, 0, 0, 1], #[5, 5, 0, 5, 5, 0, 0, 5], #[7, 7, 0, 7, 7, 0, 0, 7],
    #[11, 11, 0, 11, 11, 0, 0, 11]]
