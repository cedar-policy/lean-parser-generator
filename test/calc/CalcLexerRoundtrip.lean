def renderTok : Tok → String
  | .PLUS => "+"
  | .TIMES => "*"
  | .LPAR => "("
  | .RPAR => ")"
  | .DIV => "/"
  | _ => ""

def render (ts : List Tok) : String := ts.foldr (fun t acc => renderTok t ++ " " ++ acc) ""

theorem roundtrip_PLUS : CalcLexer.tokenizeBare (renderTok Tok.PLUS ++ " ") = .ok [Tok.PLUS, Tok.EOF] := by native_decide
theorem roundtrip_TIMES : CalcLexer.tokenizeBare (renderTok Tok.TIMES ++ " ") = .ok [Tok.TIMES, Tok.EOF] := by native_decide
theorem roundtrip_LPAR : CalcLexer.tokenizeBare (renderTok Tok.LPAR ++ " ") = .ok [Tok.LPAR, Tok.EOF] := by native_decide
theorem roundtrip_RPAR : CalcLexer.tokenizeBare (renderTok Tok.RPAR ++ " ") = .ok [Tok.RPAR, Tok.EOF] := by native_decide
theorem roundtrip_DIV : CalcLexer.tokenizeBare (renderTok Tok.DIV ++ " ") = .ok [Tok.DIV, Tok.EOF] := by native_decide

def ReachableTok (t : Tok) : Prop := ∃ src rest, CalcLexer.tokenizeBare src = .ok (t :: rest)

theorem reachable_PLUS : ReachableTok Tok.PLUS := ⟨renderTok Tok.PLUS ++ " ", _, roundtrip_PLUS⟩
theorem reachable_TIMES : ReachableTok Tok.TIMES := ⟨renderTok Tok.TIMES ++ " ", _, roundtrip_TIMES⟩
theorem reachable_LPAR : ReachableTok Tok.LPAR := ⟨renderTok Tok.LPAR ++ " ", _, roundtrip_LPAR⟩
theorem reachable_RPAR : ReachableTok Tok.RPAR := ⟨renderTok Tok.RPAR ++ " ", _, roundtrip_RPAR⟩
theorem reachable_DIV : ReachableTok Tok.DIV := ⟨renderTok Tok.DIV ++ " ", _, roundtrip_DIV⟩

theorem reachable_NUM : ∃ v, ReachableTok (Tok.NUM v) := by
  refine ⟨?v, "0 ", ?rest, ?eq⟩
  case v => exact (match CalcLexer.tokenizeBare "0 " with
    | .ok (Tok.NUM v :: _) => v | _ => default)
  case rest => exact (match CalcLexer.tokenizeBare "0 " with
    | .ok (_ :: r) => r | _ => [])
  case eq => native_decide

theorem coverage :
    ReachableTok Tok.PLUS
    ∧ ReachableTok Tok.TIMES
    ∧ ReachableTok Tok.LPAR
    ∧ ReachableTok Tok.RPAR
    ∧ ReachableTok Tok.DIV
    ∧ (∃ v, ReachableTok (Tok.NUM v)) :=
  ⟨reachable_PLUS,
   reachable_TIMES,
   reachable_LPAR,
   reachable_RPAR,
   reachable_DIV,
   reachable_NUM⟩

abbrev Roundtrips (s : List Tok) : Prop :=
